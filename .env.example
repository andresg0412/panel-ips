# Rol de solo lectura panel_lectura (ver deploy/crear-rol.sql).
# En el droplet el host es el contenedor de Postgres en shared_network.
DATABASE_URL=postgres://panel_lectura:CAMBIAR@ips-centro-orientacion-db-1:5432/db_ipscentrodeorientacion
# Rol panel_app: solo escribe en el esquema `panel` (ver deploy/crear-esquema-panel.sql).
DATABASE_URL_APP=postgres://panel_app:CAMBIAR@ips-centro-orientacion-db-1:5432/db_ipscentrodeorientacion
PORT=8100

# Vigilante de soporte (opcionales). Por defecto revisa los contenedores de proyecto-ips y el dominio del bot.
# Una variable vacía desactiva esa comprobación (útil en desarrollo local). VIGILANTE=off lo apaga entero.
# VIGILANTE_BACKEND_URL=http://ips-centro-orientacion-backend-1:8000
# VIGILANTE_SCRAPER_URL=http://ips-centro-orientacion-scraper-1:3000
# VIGILANTE_BOT_URL=https://chatbotips.zentrixsolucionesdigitales.com

# --- Login propio (ver README, "Login propio y usuarios") ---
# sesion (por defecto): identidad solo desde la cookie de sesión. nginx: SOLO la transición del despliegue, con
# autenticación básica en nginx y X-Remote-User. Un valor inválido impide arrancar.
# PANEL_AUTH_MODO=sesion
# Llave del HMAC de los códigos de recuperación (mínimo 32 bytes en base64). Obligatoria en modo sesion; NO va en la
# base. Genere una propia: openssl rand -base64 32
PANEL_AUTH_SECRET=
# Correo de recuperación y avisos: resend, brevo o memoria (solo pruebas; se rechaza en producción). Sin proveedor
# el login funciona, pero la recuperación responde "No disponible por ahora".
EMAIL_PROVEEDOR=
EMAIL_API_KEY=
# Opcional. Por defecto: Panel IPS - Centro de Orientación <no-reply@zentrixsolucionesdigitales.com>
# EMAIL_REMITENTE=

# Solo desarrollo local con PANEL_AUTH_MODO=nginx (sin nginx): usuario con el que se entra.
# PANEL_USUARIO_DEV=soporte
